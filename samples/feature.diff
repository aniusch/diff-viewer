diff --git a/src/middleware/rate-limit.js b/src/middleware/rate-limit.js
new file mode 100644
index 0000000..9d1e7c3
--- /dev/null
+++ b/src/middleware/rate-limit.js
@@ -0,0 +1,14 @@
+module.exports = function rateLimit({ windowMs, max }) {
+  const hits = new Map();
+  return (req, res, next) => {
+    const now = Date.now();
+    const entry = hits.get(req.ip) || { count: 0, start: now };
+    if (now - entry.start > windowMs) Object.assign(entry, { count: 0, start: now });
+    entry.count += 1;
+    hits.set(req.ip, entry);
+    if (entry.count > max) return res.status(429).send("Too many requests");
+    next();
+  };
+};
